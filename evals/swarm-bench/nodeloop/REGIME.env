# THE PRODUCT REGIME (sb-5) — Mihai 2026-08-15: "implement it and use that to run".
# Read at sweep.py import; survives watchdog restarts (F817's lesson). Flipping this file IS
# the regime switch; complete() re-queues every row whose scorer_version differs.
BENCH_PRODUCT=1
BENCH_SPEC=/Users/mihaiperdum/Projects/goose/evals/swarm-bench/spec-build-v2.md
# F825 vendor-truth needs the POST probe armed; F826 measured findings-without-consumers —
# fix_sched (proven live, F799) is the consumer.
GOOSE_SWARM_PROBE_ADVERTISED_POST=1
GOOSE_SWARM_FIX_SCHED=1
GOOSE_SWARM_RENDER_PROBE=/Users/mihaiperdum/Projects/goose/evals/swarm-bench/bench/product_probe.mjs
GOOSE_SWARM_RENDER_NODE=/Users/mihaiperdum/.nvm/versions/node/v22.22.0/bin/node
GOOSE_SWARM_SHIP_BEST=1
BENCH_SKIP_N1=1
GOOSE_SWARM_TESTGEN=1
BENCH_ROLLING=1
# F854: the ladder's own shadow said would_skip_ladder=true while the run paid 756s redrafting a
# structurally identical plan (struct_conv 100 both rounds). diverse_plan enforces the SAME
# predicate the shadow computes; structural convergence is pool-invariant by construction, so this
# is the multi-node-only planning tax coming off. Residual: archive says ladder +0.035 mean at
# 0.39 SE (observational) — watch quality on the next pairs.
GOOSE_SWARM_DIVERSE_PLAN=1
# F856 note: the fix cap scales up to 2x with tree bytes AND the engine's complete-cap lift now
# budgets rounds against the SCALED value (adversarial-review fix) — no regime-side cap pin
# needed; pinning one here would mask the engine mechanism (the F837 lesson).
# Mihai 2026-08-16: "reduce the temperature to avoid such disparity... they'll be more
# predictable." Cools the single-sample paths (workers/detail/sink/judge) where low temp is
# correct for code; skeleton drafts keep draft_temp. WATCH: repair twins share this default —
# their diversity now rides sampling seeds alone; if wave conversion drops, per-twin jitter is
# the queued follow-up.
GOOSE_SWARM_TEMP=0.2
# F873: env pin — a stale saved config.yaml shadowed the baked split_fat default
GOOSE_SWARM_SPLIT_FAT=1
# F876: forward the fetched vendor docs verbatim to workers (scouts fetch them; nothing consumed them)
GOOSE_SWARM_DOC_PREFETCH=1
