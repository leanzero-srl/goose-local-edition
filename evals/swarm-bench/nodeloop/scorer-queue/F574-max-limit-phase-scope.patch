    def test_max_limit_ignores_build_phase_requests():
        mark = {"__phase__": "sync1", "method": "-", "path": "-", "status": 0, "query": {}}
        get = lambda lim: {"path": "/v1/payments", "method": "GET", "status": 200,
                           "query": {"limit": str(lim)}}
        # A client that never issued a graded request must score zero, whatever the build did.
        assert _trace_split([get(100), get(100), mark])[3] == 0
        # The graded value wins even when it is LOWER than the build's.
        assert _trace_split([get(100), mark, get(25)])[3] == 25
        # An unmarked trace still grades whole, so older traces do not silently zero out.
        assert _trace_split([get(50)])[3] == 50
