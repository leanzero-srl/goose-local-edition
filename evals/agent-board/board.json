{
  "board_version": "board-0",
  "_comment": "JSON, not YAML, because the harness must run with a bare Python and no pip install. Per-fixture meta.yaml stays YAML: it is flat, human-authored, and its comments explain why a defect is a fair test.",
  "verticals": {
    "repair": {
      "probe": "repair",
      "fixtures": [
        "slugkit-easy",
        "shiftlog-medium",
        "ledgerfold-hard"
      ]
    },
    "testwrite": {
      "probe": "testwrite",
      "fixtures": [
        "slugkit-mutants",
        "ledgerfold-mutants"
      ]
    },
    "build": {
      "probe": "build",
      "fixtures": [
        "taskq-spec"
      ]
    }
  },
  "_baselines": "Model ids verified live on this account: GET bedrock.us-east-1/foundation-models plus a real converse call returning tokens for each. Credentials come from a file OUTSIDE the repo and never enter an episode record.",
  "entrants": [
    {
      "name": "local-swarm-1node",
      "target": "swarm",
      "nodes": 1
    },
    {
      "name": "local-swarm-2node",
      "target": "swarm",
      "nodes": 2
    },
    {
      "name": "local-swarm-3node",
      "target": "swarm",
