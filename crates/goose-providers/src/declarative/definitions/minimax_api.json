{
  "name": "minimax_api",
  "engine": "openai",
  "display_name": "MiniMax API",
  "description": "MiniMax models via the native OpenAI-compatible API.",
  "api_key_env": "MINIMAX_API_KEY",
  "base_url": "${MINIMAX_API_BASE_URL}",
  "env_vars": [
    {
      "name": "MINIMAX_API_BASE_URL",
      "required": false,
      "secret": false,
      "default": "https://api.minimax.io/v1",
      "description": "MiniMax OpenAI-compatible API base URL."
    }
  ],
  "catalog_provider_id": "minimax",
  "dynamic_models": true,
  "model_doc_link": "https://platform.minimax.io/docs/api-reference/text-openai-api",
  "preserves_thinking": true,
  "openai_request_profile": "minimax_m3",
  "models": [
    {
      "name": "MiniMax-M3",
      "context_limit": 1000000,
      "reasoning": true
    }
  ],
  "supports_streaming": true
}
