+        let rows = (0..<1024).map { index in
+            TranscriptItem(id: "scale-\(index)", revision: 80, role: index.isMultiple(of: 2) ? "user" : "assistant",
+                text: "Loaded message \(index). " + String(repeating: "A measured transcript line with enough text to wrap naturally. ", count: 1 + index % 24), timestamp: nil)
+        }
+        let (store, _) = try await historyStore(transcript: rows)
+        let work = entry().work
+        await store.select(work)
+        let scene = try XCTUnwrap(UIApplication.shared.connectedScenes.first as? UIWindowScene)
+        let previous = scene.keyWindow
+        let window = UIWindow(windowScene: scene)
+        let host = UIHostingController(rootView: NavigationStack { SessionDetailView(work: work).environment(store) })
+        window.rootViewController = host
+        let started = Date()
+        window.makeKeyAndVisible()
+        defer { window.isHidden = true; previous?.makeKey() }
+        host.view.layoutIfNeeded()
+        await Task.yield()
+        host.view.layoutIfNeeded()
+        func allScrollViews(_ view: UIView) -> [UIScrollView] {
+            (view as? UIScrollView).map { [$0] } ?? view.subviews.flatMap(allScrollViews)
+        }
+        let scroll = try XCTUnwrap(allScrollViews(host.view).max { $0.contentSize.height < $1.contentSize.height })
+        let laidOut = Date().timeIntervalSince(started)
+        XCTAssertEqual(store.selectedWork?.transcript.count, 1024)
+        XCTAssertGreaterThan(scroll.contentSize.height, scroll.bounds.height * 100, "The large transcript must be laid out, not replaced by an empty loading surface")
+        XCTAssertLessThan(laidOut, 5, "Initial loaded-history layout must not stall interaction for multiple seconds")
+        var worstScrollWork: TimeInterval = 0
+        for fraction in [0.0, 0.25, 0.75, 0.5, 1.0] {
+            let step = Date()
+            let top = -scroll.adjustedContentInset.top
+            let bottom = scroll.contentSize.height - scroll.bounds.height + scroll.adjustedContentInset.bottom
+            let target = top + (bottom - top) * fraction
+            scroll.setContentOffset(CGPoint(x: 0, y: target), animated: false)
+            host.view.layoutIfNeeded()
+            await Task.yield()
+            host.view.layoutIfNeeded()
+            worstScrollWork = max(worstScrollWork, Date().timeIntervalSince(step))
+            XCTAssertEqual(scroll.contentOffset.y, target, accuracy: 1, "Loaded-history navigation must reach its measured offset")
+        }
+        XCTAssertLessThan(worstScrollWork, 0.5, "A measured scroll must remain responsive at eight loaded pages")
