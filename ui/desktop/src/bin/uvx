#!/bin/bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/goose-shim-common.sh" uvx

goose_uvx_setup() {
    goose_hermit_bootstrap linux

    log "Installing python 3.10 with hermit."
    hermit install python3@3.10

    log "Installing UV with hermit."
    hermit install uv

    log "uv: $(which uv)"
    log "uvx: $(which uvx)"
    goose_hermit_release_lock

    if [ -n "${GOOSE_UV_REGISTRY:-}" ] && curl -s --head --fail "${GOOSE_UV_REGISTRY}" > /dev/null; then
        log "${GOOSE_UV_REGISTRY} is accessible, setting it as UV_INDEX_URL. Setting UV_NATIVE_TLS to true."
        export UV_INDEX_URL="${GOOSE_UV_REGISTRY}"
        export UV_NATIVE_TLS=true
    else
        log "GOOSE_UV_REGISTRY is either not set or not accessible. Using the default configuration."
    fi

    log "uvx setup completed."
}

goose_uvx_setup < /dev/null >> "${LOG_FILE}" 2>&1

goose_shim_exec "${MCP_HERMIT_DIR}/bin/uvx" "$@"
