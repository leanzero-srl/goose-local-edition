+++ b/src/utils/lifeline.js
@@ -0,0 +1,43 @@
+/**
+ * A stdio MCP server lives exactly as long as its client (goose Q-138).
+ *
+ * The StdioServerTransport listens for stdin 'data' and 'error' only, so a client that dies leaves
+ * this process running whenever anything else holds the event loop open (a Puppeteer browser, a
+ * timer) — measured 2026-09-26: two bundled-MCP orphans idled for days after their goose ended.
+ * stdin EOF/close ends the process; an error on stdout/stderr (EPIPE: the reader is gone) ends the
+ * process; a parent that changes (reparented to launchd/init) ends the process. The exit notice is a
+ * synchronous write to fd 2 that may fail silently, because fd 2 may be the pipe that is gone.
+ */
+import { writeSync } from "fs";
+
+let exiting = false;
+
+export function exitBecausePeerGone(reason) {
+  if (exiting) return;
+  exiting = true;
+  try {
+    writeSync(2, `[lifeline] client gone (${reason}); exiting\n`);
+  } catch {
+    // fd 2 is the dead pipe itself; the exit below is the report.
+  }
+  process.exit(0);
+}
+
+// Parent-death poll cadence. stdin EOF is the immediate signal and covers a dead parent on its own;
+// this poll only catches a parent that died while something else still holds the stdin write end.
+// It bounds no work — it is how often a lost parent is noticed.
+const PARENT_POLL_MS = 2_000;
+
+export function installClientLifeline() {
+  process.stdin.on("end", () => exitBecausePeerGone("stdin end"));
+  process.stdin.on("close", () => exitBecausePeerGone("stdin closed"));
+  process.stdin.on("error", (error) => exitBecausePeerGone(`stdin ${error.code ?? error.message}`));
+  process.stdout.on("error", (error) => exitBecausePeerGone(`stdout ${error.code ?? error.message}`));
+  process.stderr.on("error", (error) => exitBecausePeerGone(`stderr ${error.code ?? error.message}`));
+
+  const parent = process.ppid;
+  const watch = setInterval(() => {
+    if (process.ppid !== parent) exitBecausePeerGone(`parent ${parent} gone (now ${process.ppid})`);
+  }, PARENT_POLL_MS);
+  watch.unref();
+}
--- /dev/null
+++ b/src/utils/state-dir.js
@@ -0,0 +1,55 @@
+/**
+ * Where this server keeps its OWN files (server log, insights, document registry,
+ * tenants/OAuth state). The launch directory is never a default: an agent starts
+ * the server in the user's project (goose Q-139), so those files must not appear
+ * there unasked. Documents the user asks for still go where getOutputRoot() says.
+ *
+ * DATA_DIR (goose passes one it owns), else the per-user state directory with the
+ * reason on stderr. The logger depends on this module, so it reports on stderr itself.
+ */
+import os from "node:os";
+import path from "node:path";
+
+const SERVER_ID = "leanzero-documents";
+const reported = new Set();
+
+function reportOnce(key, message, meta) {
+  if (reported.has(key)) return;
+  reported.add(key);
+  process.stderr.write(`[paths] ${message} ${JSON.stringify(meta)}\n`);
+}
+
+function absoluteDirFromEnv(name) {
+  const raw = process.env[name]?.trim();
+  if (!raw) return undefined;
+  if (path.isAbsolute(raw)) return raw;
+  reportOnce(`relative:${name}`, `${name} is not an absolute path and is ignored: resolving it would write into the launch directory`, {
+    [name]: raw,
+    cwd: process.cwd(),
+  });
+  return undefined;
+}
+
+function userStateDir() {
+  const home = os.homedir();
+  if (!home) {
+    throw new Error("[paths] DATA_DIR is not set and the user home directory is unknown; refusing to write into the launch directory");
+  }
+  const base =
+    process.platform === "darwin"
+      ? path.join(home, "Library", "Application Support")
+      : process.platform === "win32"
+        ? process.env.LOCALAPPDATA || path.join(home, "AppData", "Local")
+        : absoluteDirFromEnv("XDG_STATE_HOME") || path.join(home, ".local", "state");
+  return path.join(base, "LeanZero", SERVER_ID);
+}
+
+export function dataDir() {
+  const configured = absoluteDirFromEnv("DATA_DIR");
+  if (configured) return configured;
+  const dir = userStateDir();
+  reportOnce("default-data-dir", "no absolute DATA_DIR is set; this server writes its own files under the per-user state directory, never the launch directory", {
+    dataDir: dir,
+  });
+  return dir;
+}
