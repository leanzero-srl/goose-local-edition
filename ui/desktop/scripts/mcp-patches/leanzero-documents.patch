+/**
+ * goose Q-454: create-doc must write a markdown pipe table as a real Word table, and
+ * its `formattingQuality` must describe the file it wrote, not the input it was given.
+ *
+ * The fixture is the exact create-doc call from E2E #3u (session message 772754): a
+ * `content` body that starts at '## ' — as the tool description tells models to — and
+ * holds seven GFM tables. Before the fix the whole body collapsed into ONE Heading 2
+ * paragraph (word/document.xml had no <w:tbl>) while the result said `tables: true`.
+ *
+ * Every expectation below is derived from the input text by this file's own reading of
+ * the markdown, never from the renderer, and checked against the unzipped XML.
+ */
+
+import "./support/isolated-data-dir.js";
+import "./support/doc-output-dir.js";
+import { describe, test, after } from "node:test";
+import assert from "node:assert";
+import fs from "node:fs/promises";
+import { readFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import JSZip from "jszip";
+
+import { createDoc } from "../src/tools/create-doc.js";
+import { editDoc } from "../src/tools/edit-doc.js";
+import { assessWrittenDocx, reconcileFormatting, assessFormattingQuality } from "../src/utils/formatting-quality.js";
+
+const ARGS = JSON.parse(
+  readFileSync(new URL("./fixtures/q454-create-doc-args.json", import.meta.url), "utf8"),
+);
+
+const outDir = await fs.mkdtemp(path.join(os.tmpdir(), "q454-"));
+after(() => fs.rm(outDir, { recursive: true, force: true }));
+// Document DNA and blueprints load from the working directory: run where neither exists,
+// so the repo's own .document-dna.json neither styles these documents nor learns from them.
+process.chdir(outDir);
+
+const DELIMITER_ROW = /^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$/;
+
+function splitRow(line) {
+  return line.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((c) => c.trim());
+}
+
+const stripEmphasis = (s) => s.replace(/\*\*(.+?)\*\*/g, "$1").replace(/\*(.+?)\*/g, "$1");
+
+/** The pipe tables in a markdown body: header + body rows, as the reader would see them. */
+function pipeTables(markdown) {
+  const lines = markdown.split("\n");
+  const tables = [];
+  for (let i = 1; i < lines.length; i++) {
+    if (!DELIMITER_ROW.test(lines[i]) || !lines[i - 1].includes("|")) continue;
+    const rows = [splitRow(lines[i - 1])];
+    for (let j = i + 1; j < lines.length && lines[j].trim().startsWith("|"); j++) {
+      rows.push(splitRow(lines[j]));
+    }
+    tables.push(rows.map((r) => r.map(stripEmphasis)));
+  }
+  return tables;
+}
+
+const decode = (s) =>
+  s.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&amp;/g, "&");
+
+const textOf = (xml) => decode([...xml.matchAll(/<w:t(?:\s[^>]*)?>([^<]*)<\/w:t>/g)].map((m) => m[1]).join(""));
+
+/** Each <w:tbl> as rows of cells: {text, xml}. */
+function docxTables(documentXml) {
+  return [...documentXml.matchAll(/<w:tbl>([\s\S]*?)<\/w:tbl>/g)].map((t) => ({
+    xml: t[0],
+    rows: [...t[1].matchAll(/<w:tr>([\s\S]*?)<\/w:tr>/g)].map((r) => ({
+      xml: r[0],
+      cells: [...r[1].matchAll(/<w:tc>([\s\S]*?)<\/w:tc>/g)].map((c) => ({ xml: c[0], text: textOf(c[1]) })),
+    })),
+  }));
+}
+
+async function documentXml(filePath) {
+  const zip = await JSZip.loadAsync(await fs.readFile(filePath));
+  return zip.file("word/document.xml").async("string");
+}
+
+/** The runs of a cell whose text equals `text`, with their run properties. */
+function runsWithText(cellXml, text) {
+  return [...cellXml.matchAll(/<w:r>([\s\S]*?)<\/w:r>/g)]
+    .map((r) => ({ props: (r[1].match(/<w:rPr>([\s\S]*?)<\/w:rPr>/) || [, ""])[1], text: textOf(r[1]) }))
+    .filter((r) => r.text === text);
+}
+
+const isOn = (props, tag) => new RegExp(`<w:${tag}/>|<w:${tag} w:val="(true|1|on)"/>`).test(props);
+
+describe("create-doc renders the Q-454 report's pipe tables as Word tables", async () => {
+  const expected = pipeTables(ARGS.content);
+  const result = await createDoc({
+    ...ARGS,
+    outputPath: path.join(outDir, "readiness-assessment.docx"),
+    preventDuplicates: false,
+  });
+  const xml = result.success ? await documentXml(result.filePath) : "";
+  const tables = docxTables(xml);
+
+  test("the fixture is the report as sent: seven pipe tables", () => {
+    assert.strictEqual(expected.length, 7);
+    assert.strictEqual(result.success, true, result.message);
+  });
+
+  test("<w:tbl> count equals the input's pipe-table count", () => {
+    assert.strictEqual((xml.match(/<w:tbl>/g) || []).length, expected.length);
+  });
+
+  test("every header and body cell's text is in its table, in order", () => {
+    expected.forEach((rows, t) => {
+      const got = tables[t].rows.map((r) => r.cells.map((c) => c.text));
+      assert.deepStrictEqual(got, rows, `table ${t + 1} (header: ${rows[0].join(" | ")})`);
+    });
+  });
+
+  test("the first row is a repeating header row, bold, in the preset's header fill", () => {
+    assert.strictEqual(tables.length, expected.length);
+    for (const table of tables) {
+      const header = table.rows[0];
+      assert.match(header.xml, /<w:tblHeader\/>/);
+      for (const cell of header.cells) {
+        assert.match(cell.xml, /w:fill="2C2C2C"/, `header cell "${cell.text}" is not in professional's fill`);
+        for (const run of runsWithText(cell.xml, cell.text)) assert.ok(isOn(run.props, "b"), `header "${cell.text}" not bold`);
+      }
+    }
+  });
+
+  test("tables carry borders in the preset's colours", () => {
+    assert.strictEqual(tables.length, expected.length);
+    for (const table of tables) {
+      const borders = table.xml.match(/<w:tblBorders>([\s\S]*?)<\/w:tblBorders>/);
+      assert.ok(borders, "no <w:tblBorders>");
+      assert.match(borders[1], /<w:top w:val="single"[^>]*w:color="999999"/);
+      assert.match(borders[1], /<w:insideH w:val="single"[^>]*w:color="CCCCCC"/);
+    }
+  });
+
+  test("**bold** inside a cell survives as a bold run with the markers removed", () => {
+    const eol = tables.find((t) => t.rows[0].cells[0].text === "Date");
+    const cell = eol.rows[1].cells[0];
+    assert.strictEqual(cell.text, "30 March 2026");
+    const runs = runsWithText(cell.xml, "30 March 2026");
+    assert.ok(runs.length === 1 && isOn(runs[0].props, "b"), "the date is not a bold run");
+    assert.ok(!cell.xml.includes("**"));
+  });
+
+  test("the headings, bullets and callout around the tables are written too", () => {
+    const headings = ARGS.content.split("\n").filter((l) => /^## /.test(l)).length;
+    assert.strictEqual((xml.match(/<w:pStyle w:val="Heading2"\/>/g) || []).length, headings);
+    assert.ok(textOf(xml).includes("1. Executive Summary"), "a numbered heading lost its number");
+    const bullets = ARGS.content.split("\n").filter((l) => /^- /.test(l)).length;
+    assert.strictEqual((xml.match(/<w:numPr>/g) || []).length, bullets);
+    assert.ok(textOf(xml).includes("synthetic model"));
+  });
+
+  test("formattingQuality reports what was WRITTEN", () => {
+    const q = result.formattingQuality;
+    assert.strictEqual(q.basis, "written");
+    assert.strictEqual(q.tables, true);
+    assert.strictEqual(q.written.tables, expected.length);
+    assert.strictEqual(q.written.headings, 7);
+    assert.deepStrictEqual(q.dropped, []);
+  });
+});
+
+describe("create-doc keeps inline emphasis inside table cells", () => {
+  test("**bold** and *italic* in cells become bold and italic runs", async () => {
+    const result = await createDoc({
+      title: "Vendor Shortlist Matrix — Q4 Tooling Review",
+      content: "## Shortlist\n\n| Vendor | Note |\n|---|---|\n| **Acme Tools** | *pending* security review |\n",
+      stylePreset: "minimal",
+      outputPath: path.join(outDir, "shortlist.docx"),
+      preventDuplicates: false,
+    });
+    assert.strictEqual(result.success, true, result.message);
+    const [table] = docxTables(await documentXml(result.filePath));
+    const [vendor, note] = table.rows[1].cells;
+    assert.ok(isOn(runsWithText(vendor.xml, "Acme Tools")[0].props, "b"));
+    assert.ok(isOn(runsWithText(note.xml, "pending")[0].props, "i"));
+    assert.strictEqual(note.text, "pending security review");
+  });
+});
+
+describe("edit-doc append writes the same tables create-doc does", () => {
+  test("a markdown table, a heading object, an explicit table and a link land once each", async () => {
+    const created = await createDoc({
+      title: "Cutover Runbook — Wave One Rehearsal",
+      content: "Rehearsal notes follow.",
+      outputPath: path.join(outDir, "runbook.docx"),
+      preventDuplicates: false,
+    });
+    assert.strictEqual(created.success, true, created.message);
+
+    const edited = await editDoc({
+      filePath: created.filePath,
+      action: "append",
+      paragraphs: [
+        "## Owners\n\n| Step | Owner |\n|---|---|\n| Freeze | **Marek** |\n\nSee [the checklist](https://example.com/checklist).",
+        { text: "Rollback", headingLevel: "heading2" },
+      ],
+      tables: [[["Check", "Result"], ["Smoke test", "passed"]]],
+    });
+    assert.strictEqual(edited.success, true, edited.message);
+
+    const zip = await JSZip.loadAsync(await fs.readFile(created.filePath));
+    const xml = await zip.file("word/document.xml").async("string");
+    const tables = docxTables(xml);
+    assert.deepStrictEqual(
+      tables.map((t) => t.rows.map((r) => r.cells.map((c) => c.text))),
+      [
+        [["Step", "Owner"], ["Freeze", "Marek"]],
+        [["Check", "Result"], ["Smoke test", "passed"]],
+      ],
+    );
+    const outsideTables = textOf(xml.replace(/<w:tbl>[\s\S]*?<\/w:tbl>/g, ""));
+    assert.ok(!outsideTables.includes("Smoke test") && !outsideTables.includes("Freeze"), "table cells were written again as loose paragraphs");
+    assert.strictEqual((xml.match(/<w:pStyle w:val="Heading2"\/>/g) || []).length, 2);
+
+    const rid = xml.match(/<w:hyperlink [^>]*r:id="([^"]+)"/)?.[1];
+    assert.ok(rid, "the link was not written as a hyperlink");
+    const rels = await zip.file("word/_rels/document.xml.rels").async("string");
+    assert.match(rels, new RegExp(`Id="${rid}"[^>]*Target="https://example.com/checklist"|Target="https://example.com/checklist"[^>]*Id="${rid}"`));
+  });
+});
+
+describe("formattingQuality never claims a table the file does not hold", () => {
+  test("a body written as one heading paragraph reports tables:false and names the drop", () => {
+    const input = assessFormattingQuality({ content: ARGS.content });
+    const collapsed =
+      '<w:body><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Executive Summary | Item | Detail |</w:t></w:r></w:p></w:body>';
+    const q = reconcileFormatting(input, assessWrittenDocx(collapsed));
+    assert.strictEqual(input.tables, true);
+    assert.strictEqual(q.tables, false);
+    assert.strictEqual(q.written.tables, 0);
+    assert.ok(q.dropped.includes("tables") && q.dropped.includes("lists") && q.dropped.includes("blockquotes"));
+    assert.match(q.hint, /tables/);
+  });
+});
