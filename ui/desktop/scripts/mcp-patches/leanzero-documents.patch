--- /dev/null
+++ b/test/test-output-location.js
@@ -0,0 +1,83 @@
+// goose Q-139: an agent launches this server with cwd = the user's project. The
+// server's own files (server.log, insights, registry) must never land there, and a
+// document goes where the caller or DOC_OUTPUT_DIR says — not under <cwd>/docs.
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio.js";
+
+const entry = path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "src", "index.js");
+const sandboxes = [];
+after(() => sandboxes.forEach((dir) => fs.rmSync(dir, { recursive: true, force: true })));
+
+const tree = (dir) =>
+  fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const p = path.join(dir, e.name);
+    return e.isDirectory() ? [p + path.sep, ...tree(p)] : [p];
+  });
+
+async function createInProject(env, outputPath) {
+  const sandbox = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "docs-output-location-")));
+  sandboxes.push(sandbox);
+  const home = path.join(sandbox, "home");
+  const project = path.join(home, "projects", "app");
+  fs.mkdirSync(project, { recursive: true });
+  fs.writeFileSync(path.join(project, "package.json"), '{"name":"app"}');
+  const before = new Set(tree(sandbox));
+
+  const transport = new StdioClientTransport({
+    command: process.execPath,
+    args: [entry],
+    cwd: project,
+    env: { PATH: process.env.PATH ?? "", HOME: home, USERPROFILE: home, MCP_CLIENT_TYPE: "agent", ...env(sandbox) },
+  });
+  const client = new Client({ name: "output-location-test", version: "1.0.0" });
+  await client.connect(transport);
+  const result = await client.callTool({
+    name: "create-markdown",
+    arguments: {
+      title: "Payments Webhook Integration Guide",
+      content: "## Setup\n\nRegister the webhook endpoint and verify the signature header.\n\n## Retries\n\nFailed deliveries retry with backoff.",
+      outputPath: outputPath(sandbox),
+    },
+  });
+  await client.close();
+  assert.notEqual(result.isError, true, JSON.stringify(result.content));
+  const created = tree(sandbox).filter((p) => !before.has(p)).map((p) => path.relative(sandbox, p));
+  const touched = created.filter((p) => p.startsWith(path.join("home", "projects")) || /^home[/\\](docs|logs)/.test(p));
+  return { created, touched };
+}
+
+test("with DATA_DIR, the server's own files go there and an absolute document path is honoured", async () => {
+  const { created, touched } = await createInProject(
+    (s) => ({ DATA_DIR: path.join(s, "state") }),
+    (s) => path.join(s, "chosen", "guide.md"),
+  );
+  assert.deepEqual(touched, []);
+  assert.ok(created.includes(path.join("chosen", "guide.md")), created.join("\n"));
+  for (const own of [path.join("logs", "server.log"), path.join("logs", "insights.jsonl"), "registry.json"]) {
+    assert.ok(created.includes(path.join("state", own)), `${own} missing: ${created.join("\n")}`);
+  }
+});
+
+test("a relative document path resolves under DOC_OUTPUT_DIR, not the launch dir", async () => {
+  const { created, touched } = await createInProject(
+    (s) => ({ DATA_DIR: path.join(s, "state"), DOC_OUTPUT_DIR: path.join(s, "documents") }),
+    () => "guide.md",
+  );
+  assert.deepEqual(touched, []);
+  assert.ok(created.some((p) => p.startsWith("documents" + path.sep) && p.endsWith("guide.md")), created.join("\n"));
+});
+
+test("without DATA_DIR, the server's own files use the per-user state dir, never the project", async () => {
+  const { created, touched } = await createInProject(
+    () => ({}),
+    (s) => path.join(s, "chosen", "guide.md"),
+  );
+  assert.deepEqual(touched, []);
+  assert.ok(created.some((p) => p.includes(path.join("LeanZero", "leanzero-documents")) && p.endsWith("server.log")), created.join("\n"));
+});
