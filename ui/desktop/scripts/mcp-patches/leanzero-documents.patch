--- /dev/null
+++ b/src/utils/lifeline.js
@@ -0,0 +1,43 @@
+/**
+ * A stdio MCP server lives exactly as long as its client (goose Q-138).
+ *
+ * The StdioServerTransport listens for stdin 'data' and 'error' only, so a client that dies leaves
+ * this process running whenever anything else holds the event loop open (a Puppeteer browser, a
+ * timer) — measured 2026-09-26: two bundled-MCP orphans idled for days after their goose ended.
+ * stdin EOF/close ends the process; an error on stdout/stderr (EPIPE: the reader is gone) ends the
+ * process; a parent that changes (reparented to launchd/init) ends the process. The exit notice is a
+ * synchronous write to fd 2 that may fail silently, because fd 2 may be the pipe that is gone.
+ */
+import { writeSync } from "fs";
+
+let exiting = false;
+
+export function exitBecausePeerGone(reason) {
+  if (exiting) return;
+  exiting = true;
+  try {
+    writeSync(2, `[lifeline] client gone (${reason}); exiting\n`);
+  } catch {
+    // fd 2 is the dead pipe itself; the exit below is the report.
+  }
+  process.exit(0);
+}
+
+// Parent-death poll cadence. stdin EOF is the immediate signal and covers a dead parent on its own;
+// this poll only catches a parent that died while something else still holds the stdin write end.
+// It bounds no work — it is how often a lost parent is noticed.
+const PARENT_POLL_MS = 2_000;
+
+export function installClientLifeline() {
+  process.stdin.on("end", () => exitBecausePeerGone("stdin end"));
+  process.stdin.on("close", () => exitBecausePeerGone("stdin closed"));
+  process.stdin.on("error", (error) => exitBecausePeerGone(`stdin ${error.code ?? error.message}`));
+  process.stdout.on("error", (error) => exitBecausePeerGone(`stdout ${error.code ?? error.message}`));
+  process.stderr.on("error", (error) => exitBecausePeerGone(`stderr ${error.code ?? error.message}`));
+
+  const parent = process.ppid;
+  const watch = setInterval(() => {
+    if (process.ppid !== parent) exitBecausePeerGone(`parent ${parent} gone (now ${process.ppid})`);
+  }, PARENT_POLL_MS);
+  watch.unref();
+}
