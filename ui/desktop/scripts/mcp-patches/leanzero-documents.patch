+      assert.equal(r.isError, true, r.text);
+      assert.match(r.message, /outputPath "report\/readiness-assessment\.docx" is relative, so it must be absolute here — the chat's folder is not known to this tool/);
+      assert.match(r.message, meta === undefined ? /sent no _meta\["agent-working-dir"\]/ : /"work\/chat" is not an absolute path/);
+    }
+    assert.deepEqual(tree(s.home), before, "no file anywhere under home");
+  } finally {
+    await s.close();
+  }
+});
+
+test("Q-388 an absolute outputPath inside the chat's folder is honoured exactly — never re-categorised into docs/", async () => {
+  const s = await chatServer();
+  try {
+    // The #3r chat's folder was $HOME itself: an absolute path under it used to be pulled into ~/docs/technical.
+    const target = path.join(s.home, "work", "chat", "report", "readiness-assessment.docx");
