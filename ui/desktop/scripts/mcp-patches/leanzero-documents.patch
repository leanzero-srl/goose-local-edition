+// goose Q-454: the registry, logs and insights resolve DATA_DIR when their modules load,
+// so a test that creates real documents points it at a throwaway folder BEFORE importing
+// the tools — the user's own registry never learns about a test document.
+import { after } from "node:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const dir = mkdtempSync(path.join(os.tmpdir(), "docs-test-data-"));
+process.env.DATA_DIR = dir;
+after(() => rmSync(dir, { recursive: true, force: true }));
