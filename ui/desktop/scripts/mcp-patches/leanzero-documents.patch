@@ -0,0 +1,65 @@
+/**
+ * The folder the calling chat works in (goose Q-388).
+ *
+ * goose sends it with EVERY tools/call as `_meta["agent-working-dir"]` — the session's
+ * working directory at the moment of the call. The process cwd is only the folder the
+ * server was STARTED in: it goes stale when the chat changes folder, and it is no chat's
+ * folder at all for a server that outlives or is shared across chats. So a relative path
+ * the model names resolves against the per-call folder, and when a call carries none the
+ * tool REFUSES the relative path instead of guessing one (the process cwd, ~/docs).
+ */
+import { AsyncLocalStorage } from "node:async_hooks";
+import path from "node:path";
+
+export const WORKING_DIR_META_KEY = "agent-working-dir";
+
+const store = new AsyncLocalStorage();
+
+export function runWithChatFolder(meta, fn) {
+  const raw = meta && typeof meta === "object" ? meta[WORKING_DIR_META_KEY] : undefined;
+  const folder = typeof raw === "string" && path.isAbsolute(raw) ? path.normalize(raw) : undefined;
+  return store.run({ folder, raw, resolutions: [] }, fn);
+}
+
+export function chatFolder() {
+  return store.getStore()?.folder;
+}
+
+function whyUnknown() {
+  const raw = store.getStore()?.raw;
+  return raw === undefined
+    ? `the client sent no _meta["${WORKING_DIR_META_KEY}"] with this call`
+    : `the client's _meta["${WORKING_DIR_META_KEY}"] ${JSON.stringify(raw)} is not an absolute path`;
+}
+
+export function chatFolderUnknownError(what, p) {
+  return new Error(
+    `${what} "${p}" is relative, so it must be absolute here — the chat's folder is not known to this tool (${whyUnknown()}). Pass the full absolute path.`,
+  );
+}
+
+export function refuseTilde(p, what) {
+  if (p === "~" || p.startsWith("~/") || p.startsWith("~\\")) {
+    throw new Error(`${what} "${p}" starts with ~, which this tool does not expand. Pass the full absolute path.`);
+  }
+}
+
+/** Record how a relative path was resolved, so the tool result can say it. */
+export function noteResolution(note) {
+  store.getStore()?.resolutions.push(note);
+}
+
+export function resolutionNotes() {
+  return store.getStore()?.resolutions ?? [];
+}
+
+/** An existing-file path the caller named: absolute as given, relative → the chat's folder. */
+export function resolveInChatFolder(p, what) {
+  refuseTilde(p, what);
+  if (path.isAbsolute(p)) return path.normalize(p);
+  const folder = chatFolder();
+  if (!folder) throw chatFolderUnknownError(what, p);
+  const resolved = path.resolve(folder, p);
+  noteResolution({ field: what, requested: p, resolvedAgainst: "the chat's folder", folder, path: resolved });
+  return resolved;
+}
