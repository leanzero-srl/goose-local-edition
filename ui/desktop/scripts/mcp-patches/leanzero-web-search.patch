+// goose Q-220: a page fetch that fails names the URL, the HTTP status, and what
+// to do next. A local model given "Resource not found: Request failed with status
+// code 404" guessed three sibling URLs in a row and kept guessing.
+import { describe, it, expect, beforeAll, afterAll, afterEach, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import axios, { AxiosError, AxiosHeaders } from 'axios';
+
+const TMP_DATA_DIR = mkdtempSync(path.join(tmpdir(), 'ws-fetch-failure-'));
+process.env.DATA_DIR = TMP_DATA_DIR;
+
+const { asFetchFailure, describeFetchFailure, PageFetchError } = await import('../../src/fetch-failure.js');
+const { EnhancedContentExtractor } = await import('../../src/enhanced-content-extractor.js');
+const { PdfExtractor } = await import('../../src/pdf-extractor.js');
+const { openAPIExtractor } = await import('../../src/openapi-extractor.js');
+const { fetchSitemapUrls, withTimeout } = await import('../../src/utils.js');
+type SitemapAttempt = import('../../src/utils.js').SitemapAttempt;
+
+function httpError(status: number, statusText = ''): AxiosError {
+  const headers = new AxiosHeaders();
+  return new AxiosError(`Request failed with status code ${status}`, 'ERR_BAD_REQUEST', { headers }, null, {
+    status,
+    statusText,
+    headers: {},
+    config: { headers },
+    data: '',
+  });
+}
+
+// A public literal address: the SSRF guard passes it without a DNS lookup.
+let n = 0;
+const page = (p: string) => `http://93.184.215.14/${p}-${++n}`;
+
+const NOT_FOUND_ADVICE =
+  'Do not guess another address on this site: fetch a URL taken from a search result, or run a search first with get-web-search-summaries.';
+
+afterEach(() => vi.restoreAllMocks());
+afterAll(() => rmSync(TMP_DATA_DIR, { recursive: true, force: true }));
+
+describe('asFetchFailure wording', () => {
+  const url = 'https://developer.atlassian.com/cloud/jira/guessed-page';
+
+  it('404 names the URL, the status, that the page does not exist, and the search tool', () => {
+    expect((asFetchFailure(url, httpError(404)) as Error).message).toBe(
+      `Could not fetch ${url} — HTTP 404 (Not Found): the page does not exist at this address. ${NOT_FOUND_ADVICE}`,
+    );
+  });
+
+  it('410 is the same not-found answer', () => {
+    const failure = asFetchFailure(url, httpError(410)) as InstanceType<typeof PageFetchError>;
+    expect(failure.kind).toBe('not-found');
+    expect(failure.message).toContain('HTTP 410 (Gone): the page does not exist at this address');
+  });
+
+  it('403 and 429 say the site refused, and to try another result', () => {
+    expect((asFetchFailure(url, httpError(403)) as Error).message).toBe(
+      `Could not fetch ${url} — HTTP 403 (Forbidden): the site refused the request. Try another result from the search, or a different source.`,
+    );
+    expect((asFetchFailure(url, httpError(429)) as Error).message).toBe(
+      `Could not fetch ${url} — HTTP 429 (Too Many Requests): the site refused the request because it is rate-limiting automated fetches. Try another result from the search, or come back to this page later.`,
+    );
+  });
+
+  it('5xx says the site failed on its side', () => {
+    expect((asFetchFailure(url, httpError(503)) as Error).message).toBe(
+      `Could not fetch ${url} — HTTP 503 (Service Unavailable): the site failed on its side. Try again later, or use another result.`,
+    );
+  });
+
+  it('timeouts say so, with the budget and that no status came back', async () => {
+    const hung = new Promise(() => {});
+    const err = await withTimeout(hung, 25, 'get-single-web-page-content').catch((e: unknown) => e);
+    expect((asFetchFailure(url, err) as Error).message).toBe(
+      `Could not fetch ${url} — timed out after 25 ms (no HTTP status was received). The site may be slow or down: try again once, or use another result.`,
+    );
+    const axiosTimeout = new AxiosError('timeout of 6000ms exceeded', 'ECONNABORTED');
+    expect((asFetchFailure(url, axiosTimeout) as InstanceType<typeof PageFetchError>).kind).toBe('timeout');
+    const abort = Object.assign(new Error('The operation was aborted due to timeout'), { name: 'TimeoutError' });
+    expect((asFetchFailure(url, abort) as InstanceType<typeof PageFetchError>).kind).toBe('timeout');
+  });
+
