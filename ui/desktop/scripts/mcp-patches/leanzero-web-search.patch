+/**
+ * A stdio MCP server lives exactly as long as its client (goose Q-138).
+ *
+ * Measured 2026-09-26: eight copies of this server outlived the goose that spawned them, six of
+ * them at 100% CPU for up to 3.4 days, all deaf to SIGTERM. The chain: goose died, so stdin hit
+ * EOF and stdout/stderr lost their reader. The StdioServerTransport listens for stdin 'data' and
+ * 'error' only, so the EOF went unnoticed. The next stderr write raised EPIPE; with no 'error'
+ * listener on the stream it became an uncaughtException; the handler logged it with
+ * console.error — another stderr write, another EPIPE, another uncaughtException — about 60,000
+ * times a second, forever.
+ *
+ * The rules here: stdin EOF/close ends the process; an EPIPE (or any error) on stdout/stderr ends
+ * the process — the peer is gone and nothing can be delivered; a parent that changes (reparented
+ * to launchd/init) ends the process. The exit notice goes to fd 2 with a synchronous write that
+ * may fail silently, because fd 2 may be the very pipe that is gone.
+ */
+import { writeSync } from 'node:fs';
+
+let exiting = false;
+
+const PEER_GONE_CODES = new Set(['EPIPE', 'ERR_STREAM_DESTROYED', 'ERR_STREAM_WRITE_AFTER_END', 'ECONNRESET']);
+
+export function isPeerGoneError(error: unknown): boolean {
+  const code = (error as { code?: unknown } | null)?.code;
+  return typeof code === 'string' && PEER_GONE_CODES.has(code);
+}
+
+export function isExiting(): boolean {
+  return exiting;
+}
+
+/** Exit now, once. Browser children are released by Playwright's own exit hook. */
+export function exitBecausePeerGone(reason: string): void {
+  if (exiting) return;
+  exiting = true;
+  try {
+    writeSync(2, `[lifeline] client gone (${reason}); exiting\n`);
+  } catch {
+    // fd 2 is the dead pipe itself; the exit below is the report.
+  }
+  process.exit(0);
+}
+
+/**
+ * Parent-death poll cadence. stdin EOF is the immediate signal and covers a dead parent on its own;
+ * this poll only catches a parent that died while something else still holds the stdin write end.
+ * It bounds no work — it is how often a lost parent is noticed.
+ */
+const PARENT_POLL_MS = 2_000;
+
+export function installClientLifeline(): void {
+  process.stdin.on('end', () => exitBecausePeerGone('stdin end'));
+  process.stdin.on('close', () => exitBecausePeerGone('stdin closed'));
+  process.stdin.on('error', (error: NodeJS.ErrnoException) => exitBecausePeerGone(`stdin ${error.code ?? error.message}`));
+  process.stdout.on('error', (error: NodeJS.ErrnoException) => exitBecausePeerGone(`stdout ${error.code ?? error.message}`));
+  process.stderr.on('error', (error: NodeJS.ErrnoException) => exitBecausePeerGone(`stderr ${error.code ?? error.message}`));
+
+  const parent = process.ppid;
+  const watch = setInterval(() => {
+    if (process.ppid !== parent) exitBecausePeerGone(`parent ${parent} gone (now ${process.ppid})`);
+  }, PARENT_POLL_MS);
+  watch.unref();
+}
