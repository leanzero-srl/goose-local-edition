+      return `the Serper key was rejected (HTTP ${status}); check "Search API key" in the LeanZero Web Search settings`;
+    }
+    if (status === 429) {
+      return 'the Serper account is out of credits or rate-limited (HTTP 429)';
+    }
+    return `HTTP ${status}`;
+  }
+  return error instanceof Error ? error.message : String(error);
+}
