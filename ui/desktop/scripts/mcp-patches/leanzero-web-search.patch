+import axios from 'axios';
+import { STATUS_CODES } from 'node:http';
+
+/**
+ * One wording for every failed fetch, so a model can act on it: the URL, the
+ * HTTP status (or that none was received), what it means, and what to do next.
+ * A bare "Request failed with status code 404" named neither the URL nor a
+ * remedy, and a local model kept guessing sibling URLs on the same site (Q-220).
+ */
+export type FetchFailureKind =
+  | 'not-found'
+  | 'refused'
+  | 'rate-limited'
+  | 'server-error'
+  | 'http-error'
+  | 'timeout'
+  | 'dns'
+  | 'network'
+  | 'unreadable'
+  | 'other';
+
+export const SEARCH_FIRST =
+  'fetch a URL taken from a search result, or run a search first with get-web-search-summaries';
+
+export interface FetchAdvice {
+  notFound?: string;
+  refused?: string;
+  rateLimited?: string;
+}
+
+export const GITHUB_ADVICE: FetchAdvice = {
+  notFound:
+    'GitHub has no such repository, branch or path, or it is private. Check the owner/repo spelling, run a search first with get-web-search-summaries to find the real repository, or call get-github-repo-content with mode "list" to see which paths exist.',
+  refused:
+    'GitHub refused the request; without a GITHUB_TOKEN its API allows 60 requests an hour, so this is usually that limit. Set GITHUB_TOKEN, or try again later.',
+  rateLimited: 'GitHub is rate-limiting this client. Set GITHUB_TOKEN for a higher limit, or try again later.',
+};
+
+const DEFAULT_ADVICE: Required<FetchAdvice> = {
+  notFound: `Do not guess another address on this site: ${SEARCH_FIRST}.`,
+  refused: 'Try another result from the search, or a different source.',
+  rateLimited: 'Try another result from the search, or come back to this page later.',
+};
+
+export class PageFetchError extends Error {
+  readonly url: string;
+  readonly kind: FetchFailureKind;
+  readonly status?: number;
+  /** Status and meaning without the URL or the advice — for lists that already show the URL. */
+  readonly brief: string;
+  readonly advice: string;
+
+  constructor(url: string, kind: FetchFailureKind, brief: string, advice: string, status?: number) {
+    super(`Could not fetch ${url} — ${brief}.${advice ? ` ${advice}` : ''}`);
+    this.name = 'PageFetchError';
+    this.url = url;
+    this.kind = kind;
+    this.brief = brief;
+    this.advice = advice;
+    this.status = status;
+  }
+
+  /** Retrying cannot change the answer: the page or the host is not there. */
+  get definitive(): boolean {
+    return this.kind === 'not-found' || this.kind === 'dns';
+  }
+
+  withNote(note: string): PageFetchError {
+    return new PageFetchError(this.url, this.kind, `${this.brief}; ${note}`, this.advice, this.status);
+  }
+}
+
+function statusLabel(status: number, statusText?: string): string {
+  const text = STATUS_CODES[status] ?? statusText?.trim();
+  return text ? `HTTP ${status} (${text})` : `HTTP ${status}`;
+}
+
+export function httpStatusFailure(
+  url: string,
+  status: number,
+  statusText?: string,
+  advice: FetchAdvice = {},
+): PageFetchError {
+  const label = statusLabel(status, statusText);
+  const say = { ...DEFAULT_ADVICE, ...advice };
+  if (status === 404 || status === 410) {
+    return new PageFetchError(url, 'not-found', `${label}: the page does not exist at this address`, say.notFound, status);
+  }
+  if (status === 401 || status === 403) {
+    return new PageFetchError(url, 'refused', `${label}: the site refused the request`, say.refused, status);
+  }
+  if (status === 429) {
+    return new PageFetchError(
+      url,
+      'rate-limited',
+      `${label}: the site refused the request because it is rate-limiting automated fetches`,
+      say.rateLimited,
+      status,
+    );
+  }
+  if (status >= 500) {
+    return new PageFetchError(
+      url,
+      'server-error',
+      `${label}: the site failed on its side`,
+      'Try again later, or use another result.',
+      status,
+    );
+  }
+  return new PageFetchError(url, 'http-error', label, 'Check the address, or use another result.', status);
+}
+
+const NO_STATUS = 'no HTTP status was received';
+const DNS_CODES = new Set(['ENOTFOUND']);
+const NETWORK_CODES = new Set([
+  'ECONNREFUSED',
+  'ECONNRESET',
+  'EHOSTUNREACH',
+  'ENETUNREACH',
+  'EAI_AGAIN',
+  'EPIPE',
+  'CERT_HAS_EXPIRED',
+  'DEPTH_ZERO_SELF_SIGNED_CERT',
+  'UNABLE_TO_VERIFY_LEAF_SIGNATURE',
+  'ERR_TLS_CERT_ALTNAME_INVALID',
+]);
+
+function errorCode(error: unknown): string | undefined {
+  const own = (error as { code?: unknown })?.code;
+  if (typeof own === 'string') return own;
+  const cause = (error as { cause?: { code?: unknown } })?.cause?.code;
+  return typeof cause === 'string' ? cause : undefined;
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).hostname;
+  } catch {
+    return url;
+  }
+}
+
+function timeoutFailure(url: string, message: string): PageFetchError {
+  const ms = message.match(/(\d+)\s*ms/i)?.[1];
+  const after = ms ? `timed out after ${ms} ms` : 'timed out';
+  return new PageFetchError(
+    url,
+    'timeout',
+    `${after} (${NO_STATUS})`,
+    'The site may be slow or down: try again once, or use another result.',
+  );
+}
+
+function dnsFailure(url: string, advice: FetchAdvice): PageFetchError {
+  return new PageFetchError(
+    url,
+    'dns',
+    `the host ${hostOf(url)} does not resolve (DNS lookup failed, ${NO_STATUS})`,
+    advice.notFound ?? `The address is likely wrong: ${SEARCH_FIRST}.`,
+  );
+}
+
+function isTimeout(error: unknown, message: string): boolean {
+  const name = (error as { name?: unknown })?.name;
+  const code = errorCode(error);
+  return (
+    name === 'TimeoutError' ||
+    code === 'ECONNABORTED' ||
+    code === 'ETIMEDOUT' ||
+    /timed out|timeout/i.test(message)
+  );
+}
+
+/**
+ * The failure of a fetch of `url`, named, when `error` is one: an HTTP status,
+ * a timeout, a DNS or connection failure. Any other error (a bad argument, a
+ * parse failure) is returned unchanged so it is not relabelled as a fetch.
+ */
+export function asFetchFailure(url: string, error: unknown, advice: FetchAdvice = {}): unknown {
+  if (error instanceof PageFetchError) return error;
+  const message = error instanceof Error ? error.message : String(error);
+
+  if (axios.isAxiosError(error) && error.response) {
+    return httpStatusFailure(url, error.response.status, error.response.statusText, advice);
+  }
+
+  const code = errorCode(error);
+  if (code && DNS_CODES.has(code)) return dnsFailure(url, advice);
+  if (/net::ERR_NAME_NOT_RESOLVED/.test(message)) return dnsFailure(url, advice);
+  if (isTimeout(error, message)) return timeoutFailure(url, message);
+
+  const netErr = message.match(/net::(ERR_[A-Z_]+)/)?.[1];
+  if ((code && NETWORK_CODES.has(code)) || netErr || axios.isAxiosError(error) || message === 'fetch failed') {
+    return new PageFetchError(
+      url,
+      'network',
+      `could not connect (${code ?? netErr ?? message}, ${NO_STATUS})`,
+      'Try again, or use another result.',
+    );
+  }
+  if (/low quality content/i.test(message)) {
+    return new PageFetchError(
+      url,
+      'unreadable',
+      `the page answered but has no readable text (${message}); it may need JavaScript or be a bot check`,
+      'Try another result from the search, or a different source.',
+    );
+  }
+  return error;
+}
+
+/** Like asFetchFailure, but always a PageFetchError: for errors already known to come from fetching `url`. */
+export function describeFetchFailure(url: string, error: unknown, advice: FetchAdvice = {}): PageFetchError {
+  const named = asFetchFailure(url, error, advice);
+  if (named instanceof PageFetchError) return named;
+  const message = error instanceof Error ? error.message : String(error);
+  return new PageFetchError(url, 'other', message, 'Try another result, or a different source.');
+}
