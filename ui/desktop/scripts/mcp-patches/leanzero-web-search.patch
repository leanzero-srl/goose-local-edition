diff --git a/tests/unit/search-unavailable.test.ts b/tests/unit/search-unavailable.test.ts
new file mode 100644
index 0000000..45da1ec
--- /dev/null
+++ b/tests/unit/search-unavailable.test.ts
@@ -0,0 +1,104 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import axios, { AxiosError, AxiosHeaders } from 'axios';
+import {
+  SearchEngine,
+  SearchUnavailableError,
+  SEARCH_NOT_CONFIGURED_MESSAGE,
+  describeSerperError,
+} from '../../src/search-engine.js';
+import { ProgressiveSearchEngine } from '../../src/progressive-search-engine.js';
+
+function httpError(status: number): AxiosError {
+  const headers = new AxiosHeaders();
+  return new AxiosError('Request failed', 'ERR_BAD_REQUEST', { headers }, null, {
+    status,
+    statusText: '',
+    headers: {},
+    config: { headers },
+    data: {},
+  });
+}
+
+let counter = 0;
+const unique = (text: string) => `${text} ${++counter} ${Date.now()}`;
+
+describe('a search that could not run says why, and never blames the query', () => {
+  const saved = { ...process.env };
+  beforeEach(() => {
+    process.env.SEMANTIC_CACHE_ENABLED = 'false';
+    delete process.env.USE_SERPER_ONLY;
+    delete process.env.ENABLE_BROWSER_FALLBACKS;
+    delete process.env.SERPER_API_KEY;
+  });
+  afterEach(() => {
+    process.env = { ...saved };
+    vi.restoreAllMocks();
+  });
+
+  it('no key: rejects with the setup message and makes no call', async () => {
+    const post = vi.spyOn(axios, 'post');
+    const engine = new SearchEngine();
+    const error = await engine
+      .search({ query: unique('Atlassian Data Center end of life') })
+      .catch((e: unknown) => e);
+    expect(error).toBeInstanceOf(SearchUnavailableError);
+    expect((error as Error).message).toBe(SEARCH_NOT_CONFIGURED_MESSAGE);
+    expect((error as Error).message).toContain('Search API key');
+    expect((error as Error).message).not.toMatch(/broaden|site:|exact-phrase/);
+    expect(post).not.toHaveBeenCalled();
+  });
+
+  it('a rejected key names the key, not the query', async () => {
+    process.env.SERPER_API_KEY = 'bad';
+    vi.spyOn(axios, 'post').mockRejectedValue(httpError(401));
+    const error = await new SearchEngine()
+      .search({ query: unique('jcma versions') })
+      .catch((e: unknown) => e);
+    expect(error).toBeInstanceOf(SearchUnavailableError);
+    expect((error as Error).message).toContain('the Serper key was rejected (HTTP 401)');
+  });
+
+  it('a call that ran and matched nothing is an honest empty result', async () => {
+    process.env.SERPER_API_KEY = 'good';
+    vi.spyOn(axios, 'post').mockResolvedValue({ data: { organic: [] } });
+    const result = await new SearchEngine().search({ query: unique('zzqx nothing') });
+    expect(result.results).toEqual([]);
+    expect(result.engine).toBe('serper-only');
+  });
+
+  it('a call that ran returns its results', async () => {
+    process.env.SERPER_API_KEY = 'good';
+    vi.spyOn(axios, 'post').mockResolvedValue({
+      data: {
+        organic: [
+          {
+            title: 'Data Center End of Life',
+            link: 'https://www.atlassian.com/licensing/data-center-end-of-life',
+            snippet: 's',
+          },
+        ],
+      },
+    });
+    const result = await new SearchEngine().search({ query: unique('dc eol') });
+    expect(result.results.map((r) => r.url)).toEqual([
+      'https://www.atlassian.com/licensing/data-center-end-of-life',
+    ]);
+  });
+
+  it('progressive search does not turn a missing key into "no relevant content"', async () => {
+    const progressive = new ProgressiveSearchEngine([new SearchEngine()], { maxDepth: 2 });
+    const q = unique('Atlassian DC end of support');
+    const error = await progressive.search(q, { query: q, maxDepth: 2 }).catch((e: unknown) => e);
+    expect(error).toBeInstanceOf(SearchUnavailableError);
+    expect((error as Error).message).toBe(SEARCH_NOT_CONFIGURED_MESSAGE);
+  });
+
+  it('describes provider failures by what happened', () => {
+    expect(describeSerperError(httpError(403))).toContain('rejected (HTTP 403)');
+    expect(describeSerperError(httpError(429))).toContain('out of credits or rate-limited');
+    expect(describeSerperError(httpError(500))).toBe('HTTP 500');
+    expect(describeSerperError(new Error('getaddrinfo ENOTFOUND google.serper.dev'))).toBe(
+      'getaddrinfo ENOTFOUND google.serper.dev',
+    );
+  });
+});
