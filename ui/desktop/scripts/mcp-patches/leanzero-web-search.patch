+export function serperFailureMessage(reason: string): string {
+  return (
+    `Web search failed at the search provider (Serper): ${reason}. No search ran to completion, ` +
+    'so this says nothing about the query; rewording it will not help. ' +
+    'get-single-web-page-content still reads a page whose URL you already know.'
+  );
+}
+
+export function describeSerperError(error: unknown): string {
+  if (axios.isAxiosError(error) && error.response) {
