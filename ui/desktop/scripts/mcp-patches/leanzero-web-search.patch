+
+function httpError(status: number): AxiosError {
+  const headers = new AxiosHeaders();
+  return new AxiosError('Request failed', 'ERR_BAD_REQUEST', { headers }, null, {
+    status,
+    statusText: '',
+    headers: {},
+    config: { headers },
+    data: {},
+  });
+}
+
+let counter = 0;
+const unique = (text: string) => `${text} ${++counter} ${Date.now()}`;
+
+const hit: SearchResult = {
+  title: 'Data Center End of Life',
+  url: 'https://www.atlassian.com/licensing/data-center-end-of-life',
+  description: 'Atlassian Data Center end of life dates',
+  fullContent: '',
+  contentPreview: '',
+  wordCount: 0,
+  timestamp: 'now',
+  fetchStatus: 'success',
