+import { requestContext } from '../../src/request-context.js';
+import { browserPool } from '../../src/browser-pool.js';
+import type { SearchResult } from '../../src/types.js';
+
+function httpError(status: number): AxiosError {
+  const headers = new AxiosHeaders();
+  return new AxiosError('Request failed', 'ERR_BAD_REQUEST', { headers }, null, {
+    status,
+    statusText: '',
+    headers: {},
+    config: { headers },
+    data: {},
+  });
+}
+
+let counter = 0;
+const unique = (text: string) => `${text} ${++counter} ${Date.now()}`;
+
+const hit: SearchResult = {
+  title: 'Data Center End of Life',
+  url: 'https://www.atlassian.com/licensing/data-center-end-of-life',
+  description: 'Atlassian Data Center end of life dates',
+  fullContent: '',
+  contentPreview: '',
+  wordCount: 0,
+  timestamp: 'now',
+  fetchStatus: 'success',
+};
+
+type EngineSearch = (
+  engine: { name: string },
+  query: string,
+  numResults: number,
+  timeout: number,
+) => Promise<SearchResult[]>;
+const engineSpy = () =>
+  vi.spyOn(
+    SearchEngine.prototype as unknown as { browserEngineSearch: EngineSearch },
+    'browserEngineSearch',
+  );
+
+/** A pooled browser whose every page renders `html`; `challenge` makes the CAPTCHA probe hit. */
+function fakeBrowser(html: string, title: string, challenge = false) {
+  const page = {
+    goto: vi.fn().mockResolvedValue({ status: () => 200 }),
+    waitForSelector: vi.fn().mockResolvedValue(undefined),
+    $: vi.fn().mockResolvedValue(challenge ? {} : null),
+    content: vi.fn().mockResolvedValue(html),
+    title: vi.fn().mockResolvedValue(title),
+    close: vi.fn().mockResolvedValue(undefined),
+  };
+  const browser = { isConnected: () => true, newPage: vi.fn().mockResolvedValue(page) };
+  vi.spyOn(browserPool, 'getBrowser').mockResolvedValue(browser as never);
+  return page;
+}
+
+describe('a search that could not run says why, and never blames the query', () => {
+  const saved = { ...process.env };
+  beforeEach(() => {
+    process.env.SEMANTIC_CACHE_ENABLED = 'false';
+    delete process.env.USE_SERPER_ONLY;
+    delete process.env.ENABLE_BROWSER_FALLBACKS;
+    delete process.env.SERPER_API_KEY;
+  });
+  afterEach(() => {
+    process.env = { ...saved };
+    vi.restoreAllMocks();
+  });
+
+  it('no key on a local server: searches Yahoo in the browser first and names that engine', async () => {
+    const post = vi.spyOn(axios, 'post');
+    const search = engineSpy().mockResolvedValue([hit]);
+    const result = await new SearchEngine().search({ query: unique('Atlassian Data Center end of life') });
