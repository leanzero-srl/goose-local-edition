+// Shared console redirection setup
+import './setup.ts';
+
+import { describe, it, expect, afterAll } from 'vitest';
+import { Client } from '@modelcontextprotocol/sdk/client/index.js';
+import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+
+// goose Q-139: an agent launches this server with cwd = the user's project. The
+// server must not create docs/, logs/ or anything else there (or in its parents,
+// where the old module-relative crawl cache landed). Offline: startup creates the
+// crawl cache, research_and_save_to_markdown creates its output dir before the
+// (refused) fetch, and list-cached-documents reads the same root back.
+const sandboxes: string[] = [];
+afterAll(() => {
+  for (const dir of sandboxes) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+const tree = (dir: string): string[] =>
+  fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const p = path.join(dir, e.name);
+    return e.isDirectory() ? [p + path.sep, ...tree(p)] : [p];
+  });
+
+async function runInProject(env: Record<string, string>) {
+  const sandbox = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'ws-output-location-')));
+  sandboxes.push(sandbox);
+  const home = path.join(sandbox, 'home');
+  const project = path.join(home, 'projects', 'app');
+  fs.mkdirSync(project, { recursive: true });
+  fs.writeFileSync(path.join(project, 'package.json'), '{"name":"app"}');
+  const before = new Set(tree(sandbox));
+
+  const transport = new StdioClientTransport({
+    command: process.execPath,
+    args: [path.resolve('dist/index.js')],
+    cwd: project,
+    env: { PATH: process.env.PATH ?? '', HOME: home, USERPROFILE: home, LOCALAPPDATA: path.join(home, 'AppData', 'Local'), MCP_CLIENT_TYPE: 'agent', ...env },
+  });
+  const client = new Client({ name: 'output-location-test', version: '1.0.0' });
+  await client.connect(transport);
+  await client.callTool(
+    { name: 'research_and_save_to_markdown', arguments: { url: 'http://127.0.0.1:9/unreachable' } },
+    undefined,
+    { timeout: 60000 },
+  );
+  const listed = await client.callTool({ name: 'list-cached-documents', arguments: {} }, undefined, { timeout: 30000 });
+  await client.close();
+
+  const created = tree(sandbox).filter((p) => !before.has(p)).map((p) => path.relative(sandbox, p));
+  return { sandbox, created, listed };
+}
+
+const insideProjectOrParents = (created: string[]) =>
+  created.filter((p) => p.startsWith(path.join('home', 'projects')) || /^home[/\\](docs|logs)/.test(p));
+
+describe('files never land in the launch directory (goose Q-139)', () => {
+  it('with DATA_DIR, writes only under DATA_DIR', async () => {
+    const dataDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'ws-data-dir-')));
+    sandboxes.push(dataDir);
+    const { created } = await runInProject({ DATA_DIR: dataDir });
+    expect(insideProjectOrParents(created)).toEqual([]);
+    expect(fs.existsSync(path.join(dataDir, 'docs', 'technical', 'openapi'))).toBe(true);
+    expect(fs.existsSync(path.join(dataDir, 'docs', 'research-output'))).toBe(true);
+  }, 120000);
+
+  it('with OUTPUT_DIR, research and the crawl cache go there', async () => {
+    const outputDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'ws-output-dir-')));
+    const dataDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'ws-data-dir-')));
+    sandboxes.push(outputDir, dataDir);
+    const { created } = await runInProject({ OUTPUT_DIR: outputDir, DATA_DIR: dataDir });
+    expect(insideProjectOrParents(created)).toEqual([]);
+    expect(fs.existsSync(path.join(outputDir, 'docs', 'technical', 'openapi'))).toBe(true);
+    expect(fs.existsSync(path.join(outputDir, 'docs', 'research-output'))).toBe(true);
+  }, 120000);
+
+  it('with nothing configured (or a relative path), uses the per-user state dir, never the project', async () => {
+    for (const env of [{}, { OUTPUT_DIR: 'research', DATA_DIR: 'state' }]) {
+      const { created } = await runInProject(env);
+      expect(insideProjectOrParents(created)).toEqual([]);
+      const research = created.find((p) => p.endsWith(path.join('docs', 'research-output')));
+      expect(research).toBeDefined();
+      expect(research).toContain(path.join('LeanZero', 'leanzero-web-search'));
+    }
+  }, 240000);
+});
