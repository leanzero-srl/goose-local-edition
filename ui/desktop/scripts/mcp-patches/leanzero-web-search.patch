+    const { Client } = await import('@modelcontextprotocol/sdk/client/index.js');
+    const { InMemoryTransport } = await import('@modelcontextprotocol/sdk/inMemory.js');
+    const { WebSearchMCPServer } = await import('../../src/server.js');
+    const target = new McpServer({ name: 'fetch-failure-test', version: '0' });
+    new WebSearchMCPServer({ skipShutdownHooks: true }).registerToolsOn(target);
+    const [clientSide, serverSide] = InMemoryTransport.createLinkedPair();
+    await target.connect(serverSide);
+    client = new Client({ name: 'fetch-failure-test', version: '0' });
+    await client.connect(clientSide);
+  });
+
+  afterAll(async () => {
+    await client?.close();
+  });
+
+  it('a 404 is an error result naming the URL, the status and get-web-search-summaries', async () => {
+    const url = page('guessed');
+    vi.spyOn(axios, 'get').mockRejectedValue(httpError(404, 'Not Found'));
