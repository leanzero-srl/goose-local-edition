+  numResults: number,
+  timeout: number,
+) => Promise<SearchResult[]>;
+const engineSpy = () =>
+  vi.spyOn(
+    SearchEngine.prototype as unknown as { browserEngineSearch: EngineSearch },
+    'browserEngineSearch',
+  );
+
+/** A pooled browser whose every page renders `html`; `challenge` makes the CAPTCHA probe hit. */
+function fakeBrowser(html: string, title: string, challenge = false) {
+  const page = {
+    goto: vi.fn().mockResolvedValue({ status: () => 200 }),
+    waitForSelector: vi.fn().mockResolvedValue(undefined),
+    $: vi.fn().mockResolvedValue(challenge ? {} : null),
+    content: vi.fn().mockResolvedValue(html),
+    title: vi.fn().mockResolvedValue(title),
+    close: vi.fn().mockResolvedValue(undefined),
+  };
+  const browser = { isConnected: () => true, newPage: vi.fn().mockResolvedValue(page) };
+  vi.spyOn(browserPool, 'getBrowser').mockResolvedValue(browser as never);
+  return page;
+}
+
+describe('a search that could not run says why, and never blames the query', () => {
+  const saved = { ...process.env };
