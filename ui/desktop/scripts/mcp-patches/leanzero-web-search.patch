@@ -0,0 +1,16 @@
+/**
+ * Imported FIRST by index.ts, for its side effects only.
+ *
+ * ES module imports are evaluated before the importing module's body, so the shim that index.ts
+ * used to install in its own body ran only after server.js's whole import graph — module-level
+ * singletons (browserPool, crawlCache, …) had already printed to stdout, ahead of the initialize
+ * reply (measured 2026-09-26: six `[BrowserPool] …` / `[CrawlCache] …` lines on the JSON-RPC
+ * stream). A module imported first is evaluated first.
+ *
+ * The lifeline (goose Q-138) is armed here for the same reason: before anything else can write.
+ */
+import { installStdioSafeConsoleShim } from './logger.js';
+import { installClientLifeline } from './lifeline.js';
+
+installStdioSafeConsoleShim();
+installClientLifeline();
