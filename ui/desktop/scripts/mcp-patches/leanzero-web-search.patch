+/**
+ * Where this server may write. The launch directory is never a default: an agent
+ * starts the server in the user's project (goose Q-139), so research files, the
+ * crawl cache, insights and tenants must not appear there unasked.
+ *
+ * DATA_DIR is the server's own directory (goose passes one it owns); OUTPUT_DIR
+ * or DOC_OUTPUT_DIR is where the user asked research files to go, else DATA_DIR.
+ * Without DATA_DIR the per-user state directory is used and the reason is logged.
+ */
+import os from 'node:os';
+import path from 'node:path';
+import { logger } from './logger.js';
+
+const SERVER_ID = 'leanzero-web-search';
+const reported = new Set<string>();
+
+function reportOnce(key: string, msg: string, meta: Record<string, unknown>): void {
+  if (reported.has(key)) return;
+  reported.add(key);
+  logger.warn(msg, meta);
+}
+
+export function absoluteDirFromEnv(name: string): string | undefined {
+  const raw = process.env[name]?.trim();
+  if (!raw) return undefined;
+  if (path.isAbsolute(raw)) return raw;
+  reportOnce(`relative:${name}`, `[paths] ${name} is not an absolute path and is ignored: resolving it would write into the launch directory`, {
+    [name]: raw,
+    cwd: process.cwd(),
+  });
+  return undefined;
+}
+
+function userStateDir(): string {
+  const home = os.homedir();
+  if (!home) {
+    throw new Error('[paths] DATA_DIR is not set and the user home directory is unknown; refusing to write into the launch directory');
+  }
+  const base =
+    process.platform === 'darwin'
+      ? path.join(home, 'Library', 'Application Support')
+      : process.platform === 'win32'
+        ? process.env.LOCALAPPDATA || path.join(home, 'AppData', 'Local')
+        : absoluteDirFromEnv('XDG_STATE_HOME') || path.join(home, '.local', 'state');
+  return path.join(base, 'LeanZero', SERVER_ID);
+}
+
+/** The server's own files: insights, tenants, hosted client output, and the default output root. */
+export function dataDir(): string {
+  const configured = absoluteDirFromEnv('DATA_DIR');
+  if (configured) return configured;
+  const dir = userStateDir();
+  reportOnce('default-data-dir', '[paths] no absolute DATA_DIR is set; this server writes its own files under the per-user state directory, never the launch directory', {
+    dataDir: dir,
+  });
+  return dir;
+}
+
+/** Research markdown and (under docs/technical) the crawl cache and saved OpenAPI specs. */
+export function outputRoot(): string {
+  return absoluteDirFromEnv('OUTPUT_DIR') || absoluteDirFromEnv('DOC_OUTPUT_DIR') || dataDir();
+}
